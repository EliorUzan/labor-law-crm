# Server-only PostgreSQL connection string from the Supabase project settings.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Safe to expose to the browser; used by Supabase Auth clients in a later auth thread.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Optional canonical URL for deployment-aware links and redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
