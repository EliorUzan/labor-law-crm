# Server-only PostgreSQL connection string from the Supabase project settings.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Safe to expose to the browser; used only for Supabase Auth session handling.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Browser-safe canonical URL. Use the final HTTPS domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Electron reads this only from its launch environment, never from the renderer.
# In production it must be the approved HTTPS CRM origin. Development defaults to
# http://localhost:3000 and may be overridden with ELECTRON_START_URL.
CRM_DESKTOP_URL="https://crm.example.com"

# Server-only Google Drive OAuth (Web application client).
# Redirect URI: NEXT_PUBLIC_APP_URL + /api/documents/google/callback
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
# A stable random 32-byte hex key; keep it across deployments.
DOCUMENT_TOKEN_ENCRYPTION_KEY=""
